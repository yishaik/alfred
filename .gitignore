# Secrets — never commit
.env
.secretbox-ingest-token

# Runtime state / logs
bridge.log
bridge.log.old
restart.log
run.log
aq.jsonl
session_id.txt
state/

# Python
__pycache__/
*.py[cod]
.venv/
collapse.log
.env.*
*.bak-*

# ...but the committed template must be tracked
!.env.example

# Per-agent bridge instances (own bot tokens, own sessions/KB) — this repo is
# PUBLIC. `.env.*` above does not match `.env-<name>`; these do.
.env-*
state-*/
.token-*
.herenow/

# secretbox writes secrets into .env; the server itself is safe to commit
pages.json
tasks.json
custom_slots.json
.bootstrap.json

# Secret stores — never committed. vault.json alone holds ~180 credentials.
vault.json
grants.json
bootstrap-claims.jsonl
.secret-migration/

# --- secret material: never commit (added by tailnet security audit 2026-09-24) ---
vault.enc
vault.enc.*
vault.json*
*.pre-enc
.*_key
*.key
*.pem
.secretbox/

# Secret-ingest helper (holds credentials) and transient watchdog/selftest logs.
.ingest-secrets.mjs
watchdog.log
.selftest-after-merge.log
